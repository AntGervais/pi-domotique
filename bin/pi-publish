#!/usr/bin/env bash
# Genere le depot PUBLIC a partir de ce miroir prive.
#
# Le public est un ARTEFACT GENERE, jamais edite a la main : ce script liste
# explicitement ce qui sort, et refuse de publier s'il detecte un secret. C'est
# ce qui rend le montage sur -- on ne peut pas pousser une cle par accident.
set -uo pipefail
source "$(dirname "$0")/_manifest.sh"

PUBLIC="${PIGERVAIS_PUBLIC:-$HOME/pigervais-public}"
cd "$PI_ROOT" || { echo "✗ miroir introuvable" >&2; exit 1; }

# --- Liste blanche : rien d'autre ne sort d'ici ---
FICHIERS=(
  zigbee/docker-compose.yml
  zigbee/mosquitto.conf
  zigbee2mqtt/configuration.exemple.yaml
  nodered/flows.json
  nodered/settings.js
  nodered/package.json
  nginx/pigervais-proxy.conf
  pi-root/pigervais-nginx-apply
  scripts/hue-flow-complet.py
  scripts/hue-flow-etat.py
  bin/_manifest.sh bin/pi-pull bin/pi-push bin/pi-diff
  bin/pi-status bin/pi-backup bin/pi-compare bin/pi-publish
)

mkdir -p "$PUBLIC"
[ -d "$PUBLIC/.git" ] || (cd "$PUBLIC" && git init -q -b master)

# On repart d'un arbre propre : un fichier retire de la liste blanche doit
# disparaitre du public, pas y survivre indefiniment.
find "$PUBLIC" -mindepth 1 -maxdepth 1 -not -name '.git' -exec rm -rf {} +

for f in "${FICHIERS[@]}"; do
  [ -f "$f" ] || { echo "  · absent, ignoré : $f"; continue; }
  mkdir -p "$PUBLIC/$(dirname "$f")"
  cp -p "$f" "$PUBLIC/$f"
done
[ -f README-public.md ] && cp README-public.md "$PUBLIC/README.md"
[ -f LICENSE ] && cp LICENSE "$PUBLIC/LICENSE"
printf '.DS_Store\n' > "$PUBLIC/.gitignore"

# --- Controle anti-fuite : le filet qui justifie tout le reste ---
# Chaque motif est cherche dans TOUT ce qui va etre publie. Une seule
# correspondance annule la publication.
declare -a MOTIFS=(
  'AGE-SECRET-KEY'                      # cle de dechiffrement
  '"success".*"username"'               # cle du pont Hue
  '192\.168\.[0-9]+\.[0-9]+'            # adressage du LAN
  '100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\.[0-9]+\.[0-9]+'   # plage Tailscale
  'network_key:[[:space:]]*$'           # cle Zigbee sous forme de liste YAML
)
# Les secrets qui ne sont pas des motifs generiques viennent du trousseau :
# les ecrire ici les publierait, puisque ce script fait lui-meme partie du
# depot public. Le canal ntfy etait code en dur et livrait donc son prefixe.
for ITEM in pigervais-ssh:antoine pigervais-ntfy:url; do
  VAL=$(security find-generic-password -s "${ITEM%%:*}" -a "${ITEM##*:}" -w 2>/dev/null)
  [ -n "$VAL" ] && MOTIFS+=("$VAL")
done
echo
echo "── contrôle anti-fuite ──"
fuite=0
for m in "${MOTIFS[@]}"; do
  if trouve=$(grep -rEn "$m" "$PUBLIC" --exclude-dir=.git --exclude=pi-publish 2>/dev/null | head -3); then
    if [ -n "$trouve" ]; then
      echo "  ✗ motif interdit « $m » :"
      echo "$trouve" | sed 's/^/      /'
      fuite=1
    fi
  fi
done
if [ "$fuite" -ne 0 ]; then
  echo
  echo "✗ PUBLICATION ANNULÉE — corrige les fuites ci-dessus." >&2
  echo "  Rien n'a été poussé. Le dossier $PUBLIC contient l'arbre fautif." >&2
  exit 1
fi
echo "  ✓ aucun motif sensible détecté"

# --- Commit et push ---
cd "$PUBLIC"
git add -A
if git diff --cached --quiet; then
  echo "✓ dépôt public déjà à jour"
  exit 0
fi
git \
    commit -q -m "Update configuration ($(date '+%Y-%m-%d'))"
if git remote | grep -q origin; then
  git push -q origin HEAD && echo "✓ publié sur $(git remote get-url origin)"
else
  echo "✓ commit local fait ; aucun remote configuré pour l'instant"
fi
